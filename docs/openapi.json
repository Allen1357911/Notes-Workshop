{"openapi":"3.1.0","info":{"title":"笔记工坊 Note-Workshop 接口文档","description":"面向在校学生的读书笔记系统（基础功能：用户、读书笔记、点赞）。\n\n使用说明：\n1. 先调用「认证接口」里的注册、登录，拿到返回的 token；\n2. 点右上角 Authorize 按钮，把 token 填进去（不用手写 Bearer 前缀）；\n3. 之后即可调试所有需要登录的接口。\n\n未登录时仍可访问：注册、登录、公开笔记列表、笔记详情（公开笔记）、按点赞数排行。\n","contact":{"name":"Note-Workshop"},"version":"1.0.0"},"servers":[{"url":"http://127.0.0.1:8080","description":"Generated server url"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"管理员-内容管理与审核","description":"查看全部笔记、审核公开笔记、下架与恢复违规内容，需要管理员权限"},{"name":"点赞接口","description":"公开笔记的点赞与取消，以及我点赞过的笔记"},{"name":"社区互动-关注与作者","description":"关注/取关、粉丝与关注列表、作者主页、关注流、热门作者排行"},{"name":"管理员-评论管理","description":"查看评论、删除违规评论（逻辑删除并级联子评论），需要管理员权限"},{"name":"AI 智能客服","description":"平台答疑助手：新建会话 / 会话列表 / 查看历史 / 多轮对话 / 删除会话；会话按用户隔离"},{"name":"用户资料接口","description":"查看与修改个人资料、改密码、上传头像，全部需要登录"},{"name":"管理员-用户管理","description":"查看所有用户、禁用/启用账号，需要管理员权限"},{"name":"文件上传接口","description":"笔记配图上传，返回可直接放进笔记 imageUrls 的访问 URL"},{"name":"管理员-操作日志","description":"查询操作日志（谁、何时、对什么、做了什么、结果如何），需要管理员权限"},{"name":"管理员-AI 统计","description":"AI 调用次数、成功率、token 用量、耗时与按能力/按天分布，需要管理员权限"},{"name":"AI 辅助","description":"笔记总结 / 适宜人群推荐 / 笔记评分；生成后需手动确认才保存，一篇笔记最多保存一种"},{"name":"认证接口","description":"注册与登录，无需令牌即可访问"},{"name":"社区互动-评论","description":"发表评论与多级回复、查看评论树、删除自己的评论"},{"name":"读书笔记接口","description":"笔记的增删改查、公开/私有、配图与分页；公开内容允许匿名浏览"}],"paths":{"/api/users/me":{"get":{"tags":["用户资料接口"],"summary":"查看当前登录用户资料","description":"返回用户名、昵称、头像 URL、角色等；任何接口都不会返回密码字段。","operationId":"me","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultUserVO"}}}}}},"put":{"tags":["用户资料接口"],"summary":"修改个人资料","description":"基础阶段只支持修改昵称，最长 20 个字符。","operationId":"updateProfile","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateProfileRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultUserVO"}}}}}}},"/api/users/me/password":{"put":{"tags":["用户资料接口"],"summary":"修改密码","description":"必须提供原密码，原密码错误返回 10004。改密成功后已签发的旧令牌不会立即失效。","operationId":"changePassword","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangePasswordRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultVoid"}}}}}}},"/api/notes/{noteId}/ai-result":{"put":{"tags":["AI 辅助"],"summary":"确认保存 AI 结果","description":"只传 aiLogId（不传结果内容，保证用户改不了 AI 的结论）。保存后覆盖这篇笔记之前的 AI 结果 —— 一篇笔记最多保存一种。aiPublic 传 true 表示对其他人公开。","operationId":"confirm","parameters":[{"name":"noteId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AiConfirmRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultVoid"}}}}}},"delete":{"tags":["AI 辅助"],"summary":"撤销已保存的 AI 结果","description":"清空笔记上的 AI 结果，笔记正文不受影响。","operationId":"cancel","parameters":[{"name":"noteId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultVoid"}}}}}}},"/api/notes/{noteId}/ai-result/visibility":{"put":{"tags":["AI 辅助"],"summary":"设置 AI 结果是否公开","description":"作者决定是否让别人看到这篇笔记的 AI 结果。公开的前提是笔记本身公开且已通过审核；关闭后只有作者本人与管理员可见。","operationId":"updateVisibility","parameters":[{"name":"noteId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AiVisibilityRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultVoid"}}}}}}},"/api/notes/{id}":{"get":{"tags":["读书笔记接口"],"summary":"笔记详情","description":"返回正文、图书名、全部配图、AI 辅助结果（基础阶段为空）、点赞数与当前用户是否已赞。公开笔记未登录也能看；私有笔记仅作者本人或管理员可看，其他人返回 20004。注意：带不带令牌结果不同（私有可能看不到、liked 与 editable 会变），所以该接口不标注为匿名，在 Swagger 里点过 Authorize 之后会自动带上令牌。","operationId":"detail","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultNoteVO"}}}}}},"put":{"tags":["读书笔记接口"],"summary":"编辑笔记","description":"仅作者本人或管理员，其他人返回 20002。imageUrls 传 null 表示不改配图，传空数组表示清空。","operationId":"update","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateNoteRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultNoteVO"}}}}}},"delete":{"tags":["读书笔记接口"],"summary":"删除笔记","description":"仅作者本人或管理员。笔记、配图记录、点赞记录一并删除；磁盘上的图片文件暂不清理。","operationId":"delete","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultVoid"}}}}}}},"/api/notes/{id}/resubmit":{"put":{"tags":["读书笔记接口"],"summary":"重新提交审核","description":"把「已驳回」的公开笔记重新送回待审核队列（不用改内容）。只有作者本人或管理员可操作；私有笔记或非已驳回状态返回 20006。","operationId":"resubmit","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultNoteVO"}}}}}}},"/api/admin/users/{id}/status":{"put":{"tags":["管理员-用户管理"],"summary":"禁用 / 启用账号","description":"status 传 0 表示禁用、1 表示启用。不能禁用自己的账号（返回 10006）；禁用立即生效，该用户手里已签发的令牌也会被拦下。","operationId":"updateStatus","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateUserStatusRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultAdminUserVO"}}}}}}},"/api/admin/notes/{id}/restore":{"put":{"tags":["管理员-内容管理与审核"],"summary":"恢复已下架的笔记","description":"把已下架的笔记恢复为已通过状态，重新对外可见。","operationId":"restore","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultAdminNoteVO"}}}}}}},"/api/admin/notes/{id}/offline":{"put":{"tags":["管理员-内容管理与审核"],"summary":"下架违规笔记","description":"只有已通过审核的公开笔记能下架；下架后立即从公开列表、排行与详情中消失。remark 为下架说明，作者可见。","operationId":"offline","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OfflineNoteRequest"}}}},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultAdminNoteVO"}}}}}}},"/api/admin/notes/{id}/audit":{"put":{"tags":["管理员-内容管理与审核"],"summary":"审核笔记","description":"approved 传 true 通过（立即出现在公开广场），传 false 驳回（可带 remark 作为驳回原因，作者可见并可修改后重新提交）。只有待审核状态的笔记能审核，否则返回 20005。","operationId":"audit","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuditNoteRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultAdminNoteVO"}}}}}}},"/api/users/{id}/follow":{"post":{"tags":["社区互动-关注与作者"],"summary":"关注用户","description":"重复关注按幂等处理；不能关注自己（返回 50001）；未登录返回 401。","operationId":"follow","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultVoid"}}}}}},"delete":{"tags":["社区互动-关注与作者"],"summary":"取消关注","description":"没关注过时同样返回成功，保证幂等。","operationId":"unfollow","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultVoid"}}}}}}},"/api/users/me/avatar":{"post":{"tags":["用户资料接口"],"summary":"上传头像","description":"multipart/form-data，字段名 file；只允许 jpg/jpeg/png/gif/webp，单张不超过 5MB。图片存本地磁盘，数据库只保存访问 URL。","operationId":"uploadAvatar","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary"}},"required":["file"]}}}},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultUserVO"}}}}}}},"/api/notes":{"post":{"tags":["读书笔记接口"],"summary":"新建笔记","description":"必须指定图书名与可见性（PRIVATE 私有 / PUBLIC 公开）；配图先调上传接口拿 URL 再放进 imageUrls，最多 9 张。","operationId":"create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateNoteRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultNoteVO"}}}}}}},"/api/notes/{noteId}/comments":{"get":{"tags":["社区互动-评论"],"summary":"评论列表（含多级回复）","description":"顶层评论倒序分页，每条评论的所有回复随它一起返回（前端按层级缩进展示），可匿名访问。","operationId":"list","parameters":[{"name":"noteId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"pageQuery","in":"query","required":true,"schema":{"$ref":"#/components/schemas/PageQuery"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultPageResultCommentVO"}}}}}},"post":{"tags":["社区互动-评论"],"summary":"发表评论 / 回复","description":"parentId 不传表示对笔记发表顶层评论，传了表示回复某条评论（支持多级回复）。只能评论「公开且已通过审核」的笔记，其他情况返回 20001。","operationId":"create_1","parameters":[{"name":"noteId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateCommentRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultCommentVO"}}}}}}},"/api/notes/{noteId}/ai/{capability}":{"post":{"tags":["AI 辅助"],"summary":"生成 AI 结果（预览，不保存）","description":"capability 传 SUMMARY / AUDIENCE / SCORE。返回结果与本次生成记录 id（aiLogId），确认保存时要把 aiLogId 传回来。只有作者本人或管理员能调用；每人每天有配额（默认 20 次），未配置 API Key 返回 60001。","operationId":"generate","parameters":[{"name":"noteId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"capability","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultAiGenerateVO"}}}}}}},"/api/notes/{id}/like":{"post":{"tags":["点赞接口"],"summary":"点赞笔记","description":"只能点赞公开笔记，私有笔记返回 20003；重复点赞按幂等处理。返回该笔记最新点赞数。","operationId":"like","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultLong"}}}}}},"delete":{"tags":["点赞接口"],"summary":"取消点赞","description":"没点过赞也按幂等处理。返回该笔记最新点赞数。","operationId":"unlike","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultLong"}}}}}}},"/api/files/note-images":{"post":{"tags":["文件上传接口"],"summary":"上传笔记配图","description":"multipart/form-data，字段名 file；只允许 jpg/jpeg/png/gif/webp，单张不超过 5MB。返回形如 /uploads/note/2026/10/15/xxx.png 的 URL。","operationId":"uploadNoteImage","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary"}},"required":["file"]}}}},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultString"}}}}}}},"/api/auth/register":{"post":{"tags":["认证接口"],"summary":"注册","description":"用户名 4~20 位字母数字下划线，密码 6~20 位；密码以 BCrypt 哈希存储。用户名重复返回 10002。","operationId":"register","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultUserVO"}}}}},"security":[]}},"/api/auth/login":{"post":{"tags":["认证接口"],"summary":"登录","description":"校验通过后返回 JWT 令牌，前端后续请求放在请求头 Authorization: Bearer {token}。用户名或密码错误统一返回 10003。","operationId":"login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultLoginVO"}}}}},"security":[]}},"/api/ai/chat/sessions":{"get":{"tags":["AI 智能客服"],"summary":"我的会话列表","description":"只返回当前登录用户的会话，按最后消息时间倒序；空会话按创建时间参与排序。","operationId":"list_1","parameters":[{"name":"pageQuery","in":"query","required":true,"schema":{"$ref":"#/components/schemas/PageQuery"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultPageResultChatSessionVO"}}}}}},"post":{"tags":["AI 智能客服"],"summary":"新建会话","description":"创建一个空会话，标题为「新会话」；之后发消息时由首条成功消息取名。","operationId":"create_2","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultChatSessionVO"}}}}}}},"/api/ai/chat/sessions/{id}/messages":{"post":{"tags":["AI 智能客服"],"summary":"发送消息（多轮对话）","description":"带最近 10 轮上下文调用模型并返回回复。单条消息上限 1000 字；每人每天 100 条提问配额（独立于笔记 AI）；调用失败时不写对话记录、不扣配额，但会计入 AI 统计的失败次数。","operationId":"send","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SendChatMessageRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultChatReplyVO"}}}}}}},"/api/users/{id}":{"get":{"tags":["社区互动-关注与作者"],"summary":"作者主页信息","description":"返回昵称、头像、粉丝数、关注数、公开笔记数，以及当前用户是否已关注（可匿名访问）。","operationId":"author","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultAuthorVO"}}}}}}},"/api/users/{id}/notes":{"get":{"tags":["社区互动-关注与作者"],"summary":"作者的公开笔记","description":"只返回该作者「公开且已通过审核」的笔记，可匿名访问。","operationId":"authorNotes","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"pageQuery","in":"query","required":true,"schema":{"$ref":"#/components/schemas/PageQuery"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultPageResultNoteListVO"}}}}}}},"/api/users/{id}/following":{"get":{"tags":["社区互动-关注与作者"],"summary":"关注列表","description":"他关注了谁，按关注时间倒序分页，可匿名访问。","operationId":"following","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"pageQuery","in":"query","required":true,"schema":{"$ref":"#/components/schemas/PageQuery"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultPageResultFollowUserVO"}}}}}}},"/api/users/{id}/followers":{"get":{"tags":["社区互动-关注与作者"],"summary":"粉丝列表","description":"谁关注了他，按关注时间倒序分页，可匿名访问。","operationId":"followers","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"pageQuery","in":"query","required":true,"schema":{"$ref":"#/components/schemas/PageQuery"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultPageResultFollowUserVO"}}}}}}},"/api/notes/rank":{"get":{"tags":["读书笔记接口"],"summary":"按点赞数排行（分页）","description":"只统计公开笔记，按点赞数降序、创建时间降序排列；未登录也可以访问。","operationId":"rank","parameters":[{"name":"pageQuery","in":"query","required":true,"schema":{"$ref":"#/components/schemas/PageQuery"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultPageResultNoteRankVO"}}}}},"security":[]}},"/api/notes/public":{"get":{"tags":["读书笔记接口"],"summary":"公开笔记列表（分页）","description":"只返回 PUBLIC 的笔记，未登录也可以访问。","operationId":"publicNotes","parameters":[{"name":"pageQuery","in":"query","required":true,"schema":{"$ref":"#/components/schemas/PageQuery"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultPageResultNoteListVO"}}}}},"security":[]}},"/api/notes/my":{"get":{"tags":["读书笔记接口"],"summary":"我的笔记列表（分页）","description":"返回当前登录用户的全部笔记，包含私有与公开；page 从 1 开始，size 上限 100。","operationId":"myNotes","parameters":[{"name":"pageQuery","in":"query","required":true,"schema":{"$ref":"#/components/schemas/PageQuery"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultPageResultNoteListVO"}}}}}}},"/api/likes/my":{"get":{"tags":["点赞接口"],"summary":"我点赞过的笔记（分页）","description":"按点赞时间倒序，page 从 1 开始，size 上限 100。","operationId":"myLikes","parameters":[{"name":"pageQuery","in":"query","required":true,"schema":{"$ref":"#/components/schemas/PageQuery"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultPageResultNoteRankVO"}}}}}}},"/api/feed/following":{"get":{"tags":["社区互动-关注与作者"],"summary":"关注流","description":"我关注的人发布的「公开且已通过审核」的笔记，按发布时间倒序分页；未登录返回 401。","operationId":"followingFeed","parameters":[{"name":"pageQuery","in":"query","required":true,"schema":{"$ref":"#/components/schemas/PageQuery"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultPageResultNoteListVO"}}}}}}},"/api/authors/hot":{"get":{"tags":["社区互动-关注与作者"],"summary":"热门作者排行","description":"按粉丝数从多到少，粉丝数相同时按用户 id 升序（保证分页稳定），可匿名访问。","operationId":"hotAuthors","parameters":[{"name":"pageQuery","in":"query","required":true,"schema":{"$ref":"#/components/schemas/PageQuery"}}],"responses":{"200":{"descri